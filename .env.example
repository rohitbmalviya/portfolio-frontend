# =====================================================================
#  portfolio-frontend (Next.js — public site + /admin)  —  .env.example
#  Copy this file to ".env.local" and fill in your real values.
#  All vars are NEXT_PUBLIC_* (browser-exposed) — the frontend keeps no
#  secrets; auth is handled entirely by the backend (httpOnly cookie).
#
#  These 4 are the COMPLETE set the code reads — nothing else is used.
# =====================================================================

# Backend API base URL — no trailing slash
#   local: http://localhost:4000   prod: https://<service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Canonical site URL — used for SEO metadata + sitemap
#   local: http://localhost:3000   prod: https://<project>.vercel.app (or your domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site owner name — logo, titles, metadata (optional; defaults to "Rohit Malviya")
NEXT_PUBLIC_SITE_OWNER=Rohit Malviya

# Default theme on first visit: dark | light (optional; defaults to dark,
# still respects OS preference + the user's toggle)
NEXT_PUBLIC_DEFAULT_THEME=dark
